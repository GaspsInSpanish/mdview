<Project Sdk="Microsoft.NET.Sdk">

  <!-- W0 spike: throwaway measurement harness for the v2 native-app plan (projectoutline.md 5b).
       Not shipped. Mirrors MdView.csproj's publish settings so size numbers are comparable. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- Common.targets adds the WPF and WinForms wrappers. This raw-HWND spike
         deliberately retains only package/runtime assets and Core. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31"
                      GeneratePathProperty="true" ExcludeAssets="compile;build;buildTransitive" />
    <Reference Include="Microsoft.Web.WebView2.Core"
               HintPath="$(PkgMicrosoft_Web_WebView2)/lib_manual/netcoreapp3.0/Microsoft.Web.WebView2.Core.dll"
               Private="true" />
    <Content Include="$(PkgMicrosoft_Web_WebView2)/runtimes/win-x64/native/WebView2Loader.dll"
             Link="runtimes/win-x64/native/WebView2Loader.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="page.html" />
  </ItemGroup>

</Project>
