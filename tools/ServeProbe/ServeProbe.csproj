<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MdView</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/MdView/Rendering/**/*.cs" Link="Rendering/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/MdView/Serving/**/*.cs" Link="Serving/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/MdView/App/IBrowserLauncher.cs" Link="App/IBrowserLauncher.cs" />
    <Compile Include="../../src/MdView/App/BrowserDiscovery.cs" Link="App/BrowserDiscovery.cs" />
    <Compile Include="../../src/MdView/App/InstanceCoordinator.cs" Link="App/InstanceCoordinator.cs" />
    <Compile Include="../../src/MdView/App/Lifecycle.cs" Link="App/Lifecycle.cs" />
    <EmbeddedResource Include="../../src/MdView/Assets/**/*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/MdView/Rendering/Theme.css" Link="Rendering/Theme.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>
</Project>
