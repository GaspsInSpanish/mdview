<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' != ''">osx-arm64;osx-x64</RuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>mdview</AssemblyName>
    <RootNamespace>MdView</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../MdView/Rendering/**/*.cs" Link="Rendering/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../MdView/Serving/**/*.cs" Link="Serving/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../MdView/App/IBrowserLauncher.cs" Link="App/IBrowserLauncher.cs" />
    <Compile Include="../MdView/App/ILifecycleSignals.cs" Link="App/ILifecycleSignals.cs" />
    <Compile Include="../MdView/App/InstanceCoordinator.cs" Link="App/InstanceCoordinator.cs" />
    <Compile Include="../MdView/App/HandOffPipe.cs" Link="App/HandOffPipe.cs" />
    <Compile Include="../MdView/App/WindowFrameProtocol.cs" Link="App/WindowFrameProtocol.cs" />
    <Compile Include="../MdView/App/Lifecycle.cs" Link="App/Lifecycle.cs" />
    <EmbeddedResource Include="../MdView/Assets/**/*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../MdView/Rendering/Theme.css" Link="Rendering/Theme.css" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>
</Project>
