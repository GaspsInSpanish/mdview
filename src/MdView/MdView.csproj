<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe (not Exe) so double-clicking a .md never flashes a console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mdview</AssemblyName>
    <RootNamespace>MdView</RootNamespace>

    <!-- Single-file self-contained publish: no .NET runtime prereq on the target box. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimming is intentionally OFF: Markdig + HttpListener reflection make it risky
         for a ~5MB saving. Revisit only with a real size complaint. -->
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>0.1.0</Version>
    <Product>mdview</Product>
    <Description>Claude-artifact-style markdown reader</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every Assets file is embedded so the published .exe is genuinely standalone. -->
    <EmbeddedResource Include="Assets\**\*" />
    <EmbeddedResource Include="Rendering\Theme.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <!-- WebView2 hosted in a raw Win32 window (W0, projectoutline.md 5b). The package's own
         build targets reference its WPF/WinForms wrappers, which cost warning MSB3277 and
         are never used here, so only Core and the native loader are taken from it. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31"
                      GeneratePathProperty="true" ExcludeAssets="compile;build;buildTransitive" />
    <Reference Include="Microsoft.Web.WebView2.Core"
               HintPath="$(PkgMicrosoft_Web_WebView2)/lib_manual/netcoreapp3.0/Microsoft.Web.WebView2.Core.dll"
               Private="true" />
    <Content Include="$(PkgMicrosoft_Web_WebView2)/runtimes/win-x64/native/WebView2Loader.dll"
             Link="runtimes/win-x64/native/WebView2Loader.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
