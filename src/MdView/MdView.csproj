<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe (not Exe) so double-clicking a .md never flashes a console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mdview</AssemblyName>
    <RootNamespace>MdView</RootNamespace>

    <!-- Single-file self-contained publish: no .NET runtime prereq on the target box. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimming is intentionally OFF: Markdig + HttpListener reflection make it risky
         for a ~5MB saving. Revisit only with a real size complaint. -->
    <PublishTrimmed>false</PublishTrimmed>

    <Version>0.1.0</Version>
    <Product>mdview</Product>
    <Description>Claude-artifact-style markdown reader</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every Assets file is embedded so the published .exe is genuinely standalone. -->
    <EmbeddedResource Include="Assets\**\*" />
    <EmbeddedResource Include="Rendering\Theme.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

</Project>
